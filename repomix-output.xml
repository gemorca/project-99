<file path="js/services/detectors/dotted-lines.js">
export const DOTTED_DEFAULTS = {
  blurRadius: 7,
  inkThreshold: 18,
  maxBlobW: 14,
  maxBlobH: 5.5,
  minBlobArea: 2,
  rowTolerance: 2.2,
  minFragLen: 8,
  minFragCycles: 2,
  slantTolerance: 3.2,
  mergeGapFar: 90,
  ridgeDiff: 5,
  mergeGap: 26,
  maxGap: 10,
  minDots: 8,
  minSpan: 28,
  solidContrast: 45,
  maxSaturation: 45,
  minModulation: 28,
  maxPitch: 9,
  boxAbove: 24,
  boxBelow: 3,
  padX: 4
};

function toGray(data, n) {
  const g = new Uint8Array(n);
  for (let i = 0, p = 0; i < n; i++, p += 4) {
    g[i] = (data[p] * 77 + data[p + 1] * 150 + data[p + 2] * 29) >> 8;
  }
  return g;
}

function boxBlur(gray, w, h, r) {
  const W = w + 1;
  const integral = new Int32Array(W * (h + 1));
  for (let y = 0; y < h; y++) {
    let rowSum = 0;
    for (let x = 0; x < w; x++) {
      rowSum += gray[y * w + x];
      integral[(y + 1) * W + (x + 1)] = integral[y * W + (x + 1)] + rowSum;
    }
  }
  const out = new Uint8Array(w * h);
  for (let y = 0; y < h; y++) {
    const y0 = Math.max(0, y - r);
    const y1 = Math.min(h, y + r + 1);
    for (let x = 0; x < w; x++) {
      const x0 = Math.max(0, x - r);
      const x1 = Math.min(w, x + r + 1);
      const sum = integral[y1 * W + x1] - integral[y0 * W + x1] - integral[y1 * W + x0] + integral[y0 * W + x0];
      out[y * w + x] = (sum / ((x1 - x0) * (y1 - y0))) | 0;
    }
  }
  return out;
}

function findBlobs(ink, w, h, maxW, maxH, minArea) {
  const seen = new Uint8Array(w * h);
  const stack = new Int32Array(w * h > 4e6 ? 4e6 : w * h);
  const blobs = [];

  for (let start = 0; start < ink.length; start++) {
    if (!ink[start] || seen[start]) continue;

    let sp = 0;
    stack[sp++] = start;
    seen[start] = 1;
    let minX = w;
    let maxX = 0;
    let minY = h;
    let maxY = 0;
    let area = 0;
    let tooBig = false;

    while (sp > 0) {
      const idx = stack[--sp];
      const x = idx % w;
      const y = (idx - x) / w;
      area++;
      if (x < minX) minX = x;
      if (x > maxX) maxX = x;
      if (y < minY) minY = y;
      if (y > maxY) maxY = y;
      if (maxY - minY + 1 > maxH * 3) tooBig = true;

      for (let dy = -1; dy <= 1; dy++) {
        const ny = y + dy;
        if (ny < 0 || ny >= h) continue;
        for (let dx = -1; dx <= 1; dx++) {
          if (!dx && !dy) continue;
          const nx = x + dx;
          if (nx < 0 || nx >= w) continue;
          const ni = ny * w + nx;
          if (ink[ni] && !seen[ni] && sp < stack.length) {
            seen[ni] = 1;
            stack[sp++] = ni;
          }
        }
      }
    }

    const bw = maxX - minX + 1;
    const bh = maxY - minY + 1;
    if (tooBig || area < minArea || bh > maxH) continue;
    blobs.push({ x0: minX, x1: maxX, y0: minY, y1: maxY, cx: (minX + maxX) / 2, cy: (minY + maxY) / 2, thin: bw > maxW });
  }
  return blobs;
}

function analyzeStreak(gray, bg, rgba, w, blob, o, u) {
  const len = blob.x1 - blob.x0 + 1;
  if (len < o.minFragLen * u) return null;

  const v = new Float32Array(len);
  let satSum = 0;
  let contrastSum = 0;
  for (let x = blob.x0; x <= blob.x1; x++) {
    let m = 255;
    let my = blob.y0;
    for (let y = blob.y0; y <= blob.y1; y++) {
      const g = gray[y * w + x];
      if (g < m) {
        m = g;
        my = y;
      }
    }
    v[x - blob.x0] = m;
    const p = (my * w + x) * 4;
    satSum += Math.max(rgba[p], rgba[p + 1], rgba[p + 2]) - Math.min(rgba[p], rgba[p + 1], rgba[p + 2]);
    contrastSum += bg[my * w + x] - m;
  }
  const meanSat = satSum / len;
  const meanContrast = contrastSum / len;

  const sorted = Array.from(v).sort((a, b) => a - b);
  const p10 = sorted[Math.floor(len * 0.1)];
  const p90 = sorted[Math.floor(len * 0.9)];
  const amp = p90 - p10;

  const solidish = meanContrast >= o.solidContrast && meanSat <= o.maxSaturation;
  if (o.debugLog) o.debugLog.push({ x0: blob.x0, x1: blob.x1, y: blob.cy, len, sat: Math.round(meanSat), contrast: Math.round(meanContrast), amp: Math.round(amp), solidish });
  if (amp < o.minModulation) {
    return solidish ? { cycles: Math.max(2, Math.round(len / (6 * u))) } : null;
  }

  const mid = (p90 + p10) / 2;
  const hy = amp / 6;
  let state = v[0] > mid ? 1 : 0;
  let crossings = 0;
  for (let i = 1; i < len; i++) {
    if (state === 0 && v[i] > mid + hy) {
      state = 1;
      crossings++;
    } else if (state === 1 && v[i] < mid - hy) {
      state = 0;
      crossings++;
    }
  }
  const cycles = Math.floor(crossings / 2);
  if (cycles < o.minFragCycles || len / Math.max(cycles, 1) > o.maxPitch * u) return null;
  return { cycles };
}

export function detectDottedLines(image, options = {}) {
  const o = { ...DOTTED_DEFAULTS, ...options };
  const { width: w, height: h, data } = image;
  const u = w / 1190;

  const gray = toGray(data, w * h);
  const bg = boxBlur(gray, w, h, Math.max(2, Math.round(o.blurRadius * u)));

  const ink = new Uint8Array(w * h);
  const thr = o.inkThreshold;
  for (let i = 0; i < ink.length; i++) ink[i] = bg[i] - gray[i] > thr ? 1 : 0;

  const blobs = findBlobs(ink, w, h, o.maxBlobW * u, o.maxBlobH * u, Math.max(1, Math.round(o.minBlobArea * u * u)));
  const lines = [];
  const dots = [];
  blobs.forEach((b) => {
    if (!b.thin) {
      dots.push(b);
      return;
    }
    const st = analyzeStreak(gray, bg, data, w, b, o, u);
    if (st) lines.push({ x0: b.x0, x1: b.x1, y: b.cy, n: st.cycles });
  });
  dots.sort((a, b) => a.cy - b.cy);

  const rows = [];
  let cur = [];
  let curMean = 0;
  dots.forEach((b) => {
    if (cur.length && b.cy - curMean > o.rowTolerance * u) {
      rows.push(cur);
      cur = [];
    }
    cur.push(b);
    curMean = cur.reduce((s, q) => s + q.cy, 0) / cur.length;
  });
  if (cur.length) rows.push(cur);

  const closeLine = (chain) => {
    if (chain.length < o.minDots) return;
    const x0 = chain[0].x0;
    const x1 = chain[chain.length - 1].x1;
    const span = x1 - x0 + 1;
    if (span < o.minSpan * u) return;
    if (span / chain.length > o.maxPitch * u) return;
    const ys = chain.map((q) => q.cy).sort((a, b) => a - b);
    lines.push({ x0, x1, y: ys[ys.length >> 1], n: chain.length });
  };

  rows.forEach((row) => {
    row.sort((a, b) => a.cx - b.cx);
    let chain = [];
    row.forEach((b) => {
      if (chain.length && b.x0 - chain[chain.length - 1].x1 > o.maxGap * u) {
        closeLine(chain);
        chain = [];
      }
      chain.push(b);
    });
    closeLine(chain);
  });

  return mergeCollinear(lines, o, u, gray, w, h);
}

function hasRidge(gray, w, h, x0, x1, y, u, minDiff) {
  const yc = Math.round(y);
  const band = (ya, yb) => {
    let sum = 0;
    let n = 0;
    for (let yy = Math.max(0, ya); yy <= Math.min(h - 1, yb); yy++) {
      for (let x = Math.max(0, x0); x <= Math.min(w - 1, x1); x++) {
        sum += gray[yy * w + x];
        n++;
      }
    }
    return n ? sum / n : 255;
  };
  const r = Math.max(1, Math.round(u));
  const core = band(yc - r, yc + r);
  const above = band(yc - 6 * r, yc - 4 * r);
  const below = band(yc + 4 * r, yc + 6 * r);
  return (above + below) / 2 - core >= minDiff;
}

function crossesVerticalBorder(gray, w, h, x0, x1, y, u) {
  const half = Math.round(25 * u);
  const ya = Math.max(0, Math.round(y) - half);
  const yb = Math.min(h - 1, Math.round(y) + half);
  const need = 0.7 * (yb - ya + 1);
  const d = Math.max(3, Math.round(4 * u));
  for (let x = Math.max(d, x0); x <= Math.min(w - 1 - d, x1); x++) {
    let hits = 0;
    for (let yy = ya; yy <= yb; yy++) {
      const ref = (gray[yy * w + x - d] + gray[yy * w + x + d]) / 2;
      if (ref - gray[yy * w + x] >= 8) hits++;
    }
    if (hits >= need) return true;
  }
  return false;
}

function isBoxEdge(gray, w, h, ln, u) {
  const reach = Math.round(30 * u);
  const near = Math.max(1, Math.round(2 * u));
  const ref = Math.max(4, Math.round(5 * u));
  const verticalAt = (x) => {
    for (const dir of [-1, 1]) {
      let hits = 0;
      let total = 0;
      for (let k = Math.round(3 * u); k <= reach; k++) {
        const yy = Math.round(ln.y) + dir * k;
        if (yy < 0 || yy >= h) continue;
        total++;
        let dark = 255;
        for (let dx = -near; dx <= near; dx++) {
          const xx = Math.min(w - 1, Math.max(0, x + dx));
          dark = Math.min(dark, gray[yy * w + xx]);
        }
        const l = gray[yy * w + Math.max(0, x - ref)];
        const r = gray[yy * w + Math.min(w - 1, x + ref)];
        if ((l + r) / 2 - dark >= 8) hits++;
      }
      if (total > 0 && hits / total >= 0.6) return true;
    }
    return false;
  };
  return verticalAt(Math.round(ln.x0)) && verticalAt(Math.round(ln.x1));
}

function mergeCollinear(lines, o, u, gray, w, h) {
  const frags = [...lines].sort((a, b) => a.x0 - b.x0);
  const open = [];

  frags.forEach((f) => {
    let best = null;
    let bestScore = Infinity;
    open.forEach((L) => {
      const gap = f.x0 - L.x1;
      const dy = Math.abs(f.y - L.lastY);
      const near = gap <= o.mergeGap * u;
      const far = !near && gap <= o.mergeGapFar * u && hasRidge(gray, w, h, L.x1 + 1, f.x0 - 1, (f.y + L.lastY) / 2, u, o.ridgeDiff) && !crossesVerticalBorder(gray, w, h, L.x1 + 1, f.x0 - 1, (f.y + L.lastY) / 2, u);
      if ((near || far) && dy <= o.slantTolerance * u) {
        const score = dy * 4 + Math.max(gap, 0);
        if (score < bestScore) {
          bestScore = score;
          best = L;
        }
      }
    });
    if (best) {
      best.x1 = Math.max(best.x1, f.x1);
      best.n += f.n;
      best.ys.push(f.y);
      best.lastY = f.y;
    } else {
      open.push({ x0: f.x0, x1: f.x1, n: f.n, ys: [f.y], lastY: f.y });
    }
  });

  return open
    .filter((c) => c.x1 - c.x0 + 1 >= o.minSpan * u && c.n >= o.minDots * 0.75)
    .map((c) => {
      const ys = [...c.ys].sort((a, b) => a - b);
      return { x0: c.x0, x1: c.x1, y: ys[ys.length >> 1], n: c.n };
    })
    .filter((ln) => !isBoxEdge(gray, w, h, ln, u))
    .sort((a, b) => a.y - b.y || a.x0 - b.x0);
}

export function linesToFields(lines, width, height, options = {}) {
  const o = { ...DOTTED_DEFAULTS, ...options };
  const u = width / 1190;
  const out = [];

  lines.forEach((ln, i) => {
    let top = ln.y - o.boxAbove * u;
    const bottom = ln.y + o.boxBelow * u;
    const x0 = Math.max(0, ln.x0 - o.padX * u);
    const x1 = Math.min(width, ln.x1 + o.padX * u);

    for (let j = 0; j < i; j++) {
      const up = lines[j];
      if (up.y >= ln.y) continue;
      const overlap = Math.min(x1, up.x1) - Math.max(x0, up.x0);
      if (overlap > 0.5 * Math.min(x1 - x0, up.x1 - up.x0)) top = Math.max(top, up.y + 4 * u);
    }
    if (bottom - top < 8 * u) top = bottom - 8 * u;
    top = Math.max(0, top);

    out.push({
      x: (x0 / width) * 100,
      y: (top / height) * 100,
      w: ((x1 - x0) / width) * 100,
      h: ((bottom - top) / height) * 100,
      type: 'text',
      label: '',
      source: 'dotted-line'
    });
  });
  return out;
}

export async function dottedLinesDetector(ctx) {
  const lines = ctx.getDottedLines ? ctx.getDottedLines() : detectDottedLines(ctx.getImageData());
  return linesToFields(lines, ctx.width, ctx.height);
}
</file>

<file path="js/services/detectors/merger.js">
export const MERGE_DEFAULTS = {
  alignTol: 8,
  maxGap: 16,
  overlapDrop: 0.8,
  textareaH: 40,
  minLabeledW: 9,
  minLineH: 1.2,
  frameMinGap: 80,
  frameMaxGap: 420
};

const PRIORITY = { 'table-cell': 3, 'merged-lines': 2, 'dotted-line': 1 };
const prio = (f) => PRIORITY[f.source] || 0;

const QUESTION_START = /^(jawaban|alasan|penjelasan|kesimpulan|jelaskan|tuliskan|mengapa|bagaimana|apa|berikan|sebutkan|tentukan|buatlah|identifikasi|ide|tuliskan)/i;

function absorbs(label) {
  return !label || /[?!]$/.test(label) || QUESTION_START.test(label);
}

const baseLabel = (label) => String(label || '').replace(/\s+\d+$/, '').trim();

function toPx(f, W, H) {
  return { x0: (f.x / 100) * W, y0: (f.y / 100) * H, x1: ((f.x + f.w) / 100) * W, y1: ((f.y + f.h) / 100) * H };
}

function mergeStacks(fields, W, H, o, u) {
  const tol = o.alignTol * u;
  const gap = o.maxGap * u;
  const lines = fields
    .map((f, i) => ({ f, i, b: toPx(f, W, H) }))
    .filter((q) => q.f.source === 'dotted-line' && q.f.type !== 'textarea')
    .sort((a, b) => a.b.y0 - b.b.y0);

  const chains = [];
  lines.forEach((q) => {
    let target = null;
    for (const c of chains) {
      const last = c[c.length - 1];
      const aligned = Math.abs(q.b.x0 - last.b.x0) <= tol && q.b.x1 <= c[0].b.x1 + tol;
      const close = q.b.y0 - last.b.y1 <= gap && q.b.y0 >= last.b.y0;
      const sameLabel = !q.f.label || baseLabel(q.f.label) === baseLabel(c[0].f.label);
      if (aligned && close && absorbs(c[0].f.label) && sameLabel) {
        target = c;
        break;
      }
    }
    if (target) target.push(q);
    else chains.push([q]);
  });

  const drop = new Set();
  const added = [];
  chains.forEach((c) => {
    if (c.length < 2) return;
    c.forEach((q) => drop.add(q.i));
    const x0 = Math.min(...c.map((q) => q.b.x0));
    const y0 = Math.min(...c.map((q) => q.b.y0));
    const x1 = Math.max(...c.map((q) => q.b.x1));
    const y1 = Math.max(...c.map((q) => q.b.y1));
    const merged = {
      ...c[0].f,
      x: (x0 / W) * 100,
      y: (y0 / H) * 100,
      w: ((x1 - x0) / W) * 100,
      h: ((y1 - y0) / H) * 100,
      type: 'textarea',
      source: 'merged-lines',
      lines: c.length
    };
    added.push(merged);
  });
  return fields.filter((_, i) => !drop.has(i)).concat(added);
}

function pairFrames(fields, W, H, o, u) {
  const tol = o.alignTol * u;
  const cand = fields
    .map((f, i) => ({ f, i, b: toPx(f, W, H) }))
    .filter((q) => q.f.source === 'dotted-line' && !q.f.label)
    .sort((a, b) => a.b.y0 - b.b.y0);
  const drop = new Set();
  const added = [];
  for (let a = 0; a < cand.length; a++) {
    if (drop.has(cand[a].i)) continue;
    for (let c = a + 1; c < cand.length; c++) {
      const A = cand[a].b;
      const B = cand[c].b;
      const gapPx = B.y0 - A.y1;
      if (drop.has(cand[c].i) || gapPx < o.frameMinGap * u || gapPx > o.frameMaxGap * u) continue;
      if (Math.abs(A.x0 - B.x0) > tol || Math.abs(A.x1 - B.x1) > tol) continue;
      const inside = fields.some((f, i) => {
        if (i === cand[a].i || i === cand[c].i) return false;
        const b = toPx(f, W, H);
        const cy = (b.y0 + b.y1) / 2;
        const cx = (b.x0 + b.x1) / 2;
        return cy > A.y1 && cy < B.y0 && cx > A.x0 && cx < A.x1;
      });
      if (inside) continue;
      drop.add(cand[a].i);
      drop.add(cand[c].i);
      added.push({
        ...cand[a].f,
        x: (A.x0 / W) * 100,
        y: (A.y0 / H) * 100,
        w: ((Math.max(A.x1, B.x1) - Math.min(A.x0, B.x0)) / W) * 100,
        h: ((B.y1 - A.y0) / H) * 100,
        type: 'textarea',
        source: 'table-cell'
      });
      break;
    }
  }
  return fields.filter((_, i) => !drop.has(i)).concat(added);
}

function dropSlivers(fields, o) {
  return fields.filter((f) => {
    if (!f.label && f.w < o.minLabeledW) return false;
    if (f.source === 'dotted-line' && f.h < o.minLineH) return false;
    return true;
  });
}

function dropOverlaps(fields, W, H, o) {
  const items = fields
    .map((f) => ({ f, b: toPx(f, W, H) }))
    .map((q) => ({ ...q, area: (q.b.x1 - q.b.x0) * (q.b.y1 - q.b.y0) }))
    .sort((a, b) => prio(b.f) - prio(a.f) || b.area - a.area);
  const kept = [];
  items.forEach((q) => {
    const clash = kept.some((k) => {
      const ox = Math.min(q.b.x1, k.b.x1) - Math.max(q.b.x0, k.b.x0);
      const oy = Math.min(q.b.y1, k.b.y1) - Math.max(q.b.y0, k.b.y0);
      return ox > 0 && oy > 0 && (ox * oy) / Math.min(q.area, k.area) >= o.overlapDrop;
    });
    if (!clash) kept.push(q);
  });
  return kept.map((q) => q.f);
}

export function mergeFields(fields, W, H, options = {}) {
  const o = { ...MERGE_DEFAULTS, ...options };
  const u = W / 1190;
  let out = (fields || []).map((f) => ({ ...f }));
  out = dropSlivers(out, o);
  out = pairFrames(out, W, H, o, u);
  out = mergeStacks(out, W, H, o, u);
  out = dropOverlaps(out, W, H, o);
  out.forEach((f) => {
    if (f.source === 'merged-lines') f.type = 'textarea';
    else if (f.source !== 'table-cell') f.type = (f.h / 100) * H >= o.textareaH * u ? 'textarea' : 'text';
  });
  return out.sort((a, b) => a.y - b.y || a.x - b.x);
}
