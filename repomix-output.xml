import { requireStudentAuth, setButtonLoading, showToast, toastSubmitResult } from '../components/modal.js';
import { markDraftForClear } from '../services/outbox-status.js';
import { CACHE_KEY } from '../config.js';
import { apiPost } from '../services/api.js';
import { markSelesai } from '../services/progress.js';
import { fetchPdfArrayBuffer } from '../services/ocr.js';
import { state, uiState } from '../state.js';
import { escapeHtml as e, jsArg } from '../services/html.js';

// Batas piksel bitmap per canvas. Cegah crash memori di HP murah / iOS Safari.
const MAX_CANVAS_PIXELS = 10e6;
// Minimum 2x supaya tajam walau scale tampilan kecil (mode fit di HP).
const MIN_DPR = 2;
const MAX_DPR = 3;

// Token untuk membatalkan render fullscreen lama jika render baru dimulai (zoom cepat).
let fullscreenRenderToken = 0;

/**
 * Render satu halaman PDF ke canvas dengan resolusi HiDPI.
 * Ukuran tampilan (CSS px) tetap = page.getViewport({ scale: cssScale }).
 * Bitmap canvas = ukuran CSS x dpr, jadi tajam di layar Retina / HP.
 * Return: viewport CSS (width/height dalam CSS px).
 */
async function renderPageHiDpi(page, cssScale, canvas) {
  const cssViewport = page.getViewport({ scale: cssScale });

  let dpr = Math.min(Math.max(window.devicePixelRatio || 1, MIN_DPR), MAX_DPR);
  while (dpr > 1 && cssViewport.width * cssViewport.height * dpr * dpr > MAX_CANVAS_PIXELS) {
    dpr -= 0.25;
  }

  canvas.width = Math.floor(cssViewport.width * dpr);
  canvas.height = Math.floor(cssViewport.height * dpr);
  canvas.style.width = cssViewport.width + 'px';
  canvas.style.height = cssViewport.height + 'px';
  canvas.style.display = 'block';

  await page.render({
    canvasContext: canvas.getContext('2d'),
    viewport: page.getViewport({ scale: cssScale * dpr })
  }).promise;

  return cssViewport;
}

function activeRoot() {
  const fs = document.getElementById('lkpd-fullscreen-modal');
  if (fs && !fs.classList.contains('hidden')) return document.getElementById('lkpd-fullscreen-content') || fs;
  return document.getElementById('desktop-lkpd-pages') || document;
}

function readAnswers(root) {
  const out = {};
  (root || document).querySelectorAll('.lkpd-fill-input').forEach((el) => {
    if (el.dataset.fieldId) out[el.dataset.fieldId] = el.value;
  });
  return out;
}

async function fetchServerAnswers(idLkpd, user) {
  if (!user || !user.username || user.username === 'guest') return {};
  try {
    const res = await apiPost({ action: 'get_jawaban_lkpd_isian', id_lkpd: idLkpd, username_siswa: user.username });
    return res && res.success && res.jawaban ? res.jawaban : {};
  } catch (err) {
    return {};
  }
}

