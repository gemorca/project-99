export async function saveFieldMapGuru(idLkpd) {
  const payload = {
    totalPages: uiState.totalPagesGuru,
    renderScale: SAVED_RENDER_SCALE,
    fields: uiState.fieldsByPageGuru
  };

  const res = await apiPost({
    action: 'save_field_map_lkpd',
