    case 'game-ptm':
      titleElem.textContent = 'GAME INTERAKTIF PEMBELAJARAN';
      viewport.innerHTML = renderPertemuanTabs(paramId, viewId) + renderGameView(paramId);
      setTimeout(() => {
        initPointerDragAndDropEngine();
        initMatchingLineEngine();
